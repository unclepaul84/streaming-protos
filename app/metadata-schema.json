{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "description": { "type": "string" },
          "field": { "type": "string" }
        },
        "required": ["file", "description", "field"]
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "records": { "type": "integer" }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["name", "value"]
      }
    }
  },
  "required": ["indexes"]
}